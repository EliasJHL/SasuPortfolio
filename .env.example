# Site (copier en .env.local, et dans les variables d'environnement Netlify)
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL publique du bucket R2, sans « / » final. Vide : fichiers servis depuis public/media
VITE_MEDIAS_URL=

# Scripts locaux uniquement (jamais dans Netlify)
SUPABASE_DB_URL=postgresql://...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
